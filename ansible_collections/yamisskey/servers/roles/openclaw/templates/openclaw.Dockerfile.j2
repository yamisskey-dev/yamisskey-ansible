FROM {{ openclaw_image }}

# エージェントのシェル実行で使う汎用 CLI を追加する
#   jq, ripgrep（2026.9.3 で bundled skill の session-logs は廃止された）
# 実行時は read_only rootfs のため、ここ（ビルド時）でしか入れられない
USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends jq ripgrep \
 && rm -rf /var/lib/apt/lists/*
USER node
