# Yamix Environment Configuration
# Generated by Ansible - do not edit directly

# Application
WEB_URL=https://{{ yamix_domain }}

# Server binding (for nginx reverse proxy)
YAMIX_HOST=127.0.0.1
YAMIX_PORT={{ yamix_port | default(3026) }}

# Database
POSTGRES_PASSWORD={{ yamix_postgres_password }}

# Claude API (required for AI counseling)
ANTHROPIC_API_KEY={{ yamix_anthropic_api_key }}
ANTHROPIC_MODEL={{ yamix_anthropic_model }}

# JWT Secret (for authentication)
JWT_SECRET={{ yamix_jwt_secret }}

# Message encryption master key (base64, 32 bytes)
# 本番では必須（未設定だと yamix が起動しない）
MESSAGE_ENCRYPTION_KEY={{ yamix_message_encryption_key }}

# YAMII API Key (for AI service)
YAMII_API_KEY={{ yamix_yamii_api_key }}
